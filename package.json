{
  "name": "delta-scope",
  "version": "0.1.0",
  "description": "Power-user TUI for managing chaos across multiple git repositories",
  "type": "module",
  "author": "Jeffrey Blake",
  "license": "MIT",
  "bin": {
    "delta-scope": "./dist/cli.js",
    "ds": "./dist/cli.js"
  },
  "scripts": {
    "dev": "DEV=true tsx src/cli.tsx",
    "dev:watch": "DEV=true tsx watch src/cli.tsx",
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "git",
    "tui",
    "terminal",
    "repository",
    "manager",
    "cli"
  ],
  "dependencies": {
    "ink": "^4.4.1",
    "react": "^18.2.0",
    "simple-git": "^3.25.0",
    "conf": "^12.0.0",
    "fuzzy": "^0.1.3",
    "node-notifier": "^10.0.1",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "ink-select-input": "^5.0.0",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "ink-testing-library": "^3.0.0",
    "@vitest/coverage-v8": "^1.2.0",
    "@vitest/ui": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
